# Postgres connection string. Supabase Mumbai (ap-south-1) for hosted environments;
# use the pooled (transaction-mode) URL in production. Keep data in India (NFR-04).
DATABASE_URL="postgresql://postgres@localhost:5432/chairside"

# Separate database for `npm run test:db`. It is wiped on every run.
DATABASE_URL_TEST="postgresql://postgres@localhost:5432/chairside_test"

# Optional: max connections per server process (default 5).
DB_POOL_MAX=5

# No Supabase keys here on purpose: Pilot 0 auth is in-app (ADR-012), and the
# service-role key must never be present in the app runtime.
