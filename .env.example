# Postgres. Supabase (Mumbai region) or any Postgres connection string.
# Data residency: keep this in an Indian region — see BRD NFR-04.
DATABASE_URL="postgresql://user:password@host:5432/chairside"

# Auth. Deliberately referenced only through src/lib/auth, never directly in
# feature code, so the provider stays swappable — see docs/DECISIONS.md ADR-003.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
